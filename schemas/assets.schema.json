{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awesome-cc98.local/schemas/assets.schema.json",
  "title": "Awesome CC98 shared asset registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "assets", "candidates"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/localAsset"
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/candidate"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "mediaType": {
      "enum": [
        "image/svg+xml",
        "image/png",
        "image/jpeg",
        "image/gif",
        "image/webp",
        "image/avif",
        "audio/mpeg",
        "audio/ogg",
        "video/mp4",
        "video/webm"
      ]
    },
    "rightsStatus": {
      "enum": [
        "licensed",
        "permission_granted",
        "self_created",
        "generated",
        "permission_required",
        "unknown"
      ]
    },
    "permissionRecord": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/url"
        },
        {
          "type": "string",
          "pattern": "^docs/permissions/[a-z0-9]+(?:-[a-z0-9]+)*\\.md$"
        }
      ]
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "platform", "account_name", "account_id", "profile_url"],
      "properties": {
        "kind": {
          "enum": ["person", "organization"]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "platform": {
          "enum": ["github", "cc98"]
        },
        "account_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "account_id": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "profile_url": {
          "$ref": "#/$defs/url"
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "notes"],
      "properties": {
        "status": {
          "enum": ["clear", "public_promotion", "public_identity", "needs_redaction", "unknown"]
        },
        "notes": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "localRights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "license", "creator", "attribution", "permission_record"],
      "properties": {
        "status": {
          "$ref": "#/$defs/rightsStatus"
        },
        "license": {
          "type": ["string", "null"]
        },
        "creator": {
          "type": "string",
          "minLength": 1
        },
        "attribution": {
          "type": ["string", "null"]
        },
        "permission_record": {
          "$ref": "#/$defs/permissionRecord"
        }
      }
    },
    "localAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "file",
        "media_type",
        "alt",
        "related_exhibits",
        "subject",
        "source_url",
        "retrieved_at",
        "publish",
        "sha256",
        "rights",
        "privacy"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "role": {
          "enum": [
            "author_avatar",
            "icon",
            "hero",
            "screenshot",
            "poster",
            "sprite",
            "texture",
            "tileset",
            "prop",
            "audio",
            "video"
          ]
        },
        "file": {
          "type": "string",
          "pattern": "^assets/[A-Za-z0-9._/-]+$"
        },
        "media_type": {
          "$ref": "#/$defs/mediaType"
        },
        "alt": {
          "type": "string",
          "minLength": 1
        },
        "related_exhibits": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "subject": {
          "anyOf": [
            {
              "$ref": "#/$defs/subject"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_url": {
          "anyOf": [
            {
              "$ref": "#/$defs/url"
            },
            {
              "type": "null"
            }
          ]
        },
        "retrieved_at": {
          "type": "string",
          "format": "date"
        },
        "publish": {
          "type": "boolean"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "rights": {
          "$ref": "#/$defs/localRights"
        },
        "privacy": {
          "$ref": "#/$defs/privacy"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "role": {
                "const": "author_avatar"
              }
            }
          },
          "then": {
            "properties": {
              "media_type": {
                "enum": ["image/png", "image/jpeg", "image/webp", "image/avif"]
              },
              "related_exhibits": {
                "type": "array",
                "minItems": 1
              },
              "subject": {
                "$ref": "#/$defs/subject"
              }
            }
          }
        }
      ]
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "exhibit_id",
        "role",
        "source_page_url",
        "asset_url",
        "media_type",
        "creator",
        "owner",
        "retrieved_at",
        "publish",
        "rights",
        "privacy",
        "planned_use",
        "notes"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "exhibit_id": {
          "$ref": "#/$defs/id"
        },
        "role": {
          "enum": ["author_avatar", "icon", "hero", "screenshot", "screenshot_collection", "video", "poster", "sprite", "promotional_page"]
        },
        "related_exhibits": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "subject": {
          "$ref": "#/$defs/subject"
        },
        "source_page_url": {
          "$ref": "#/$defs/url"
        },
        "asset_url": {
          "anyOf": [
            {
              "$ref": "#/$defs/url"
            },
            {
              "type": "null"
            }
          ]
        },
        "media_type": {
          "anyOf": [
            {
              "$ref": "#/$defs/mediaType"
            },
            {
              "type": "null"
            }
          ]
        },
        "creator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "retrieved_at": {
          "type": "string",
          "format": "date"
        },
        "publish": {
          "const": false
        },
        "rights": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "license", "attribution", "permission_record"],
          "properties": {
            "status": {
              "$ref": "#/$defs/rightsStatus"
            },
            "license": {
              "type": ["string", "null"]
            },
            "attribution": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "permission_record": {
              "$ref": "#/$defs/permissionRecord"
            }
          }
        },
        "privacy": {
          "$ref": "#/$defs/privacy"
        },
        "planned_use": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["readme", "gallery", "museum", "archive", "research"]
          }
        },
        "notes": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "role": {
                "const": "author_avatar"
              }
            }
          },
          "then": {
            "required": ["related_exhibits", "subject"],
            "properties": {
              "related_exhibits": {
                "type": "array"
              },
              "subject": {
                "$ref": "#/$defs/subject"
              },
              "asset_url": {
                "$ref": "#/$defs/url"
              },
              "media_type": {
                "enum": ["image/png", "image/jpeg", "image/webp", "image/avif"]
              }
            }
          }
        }
      ]
    }
  }
}
